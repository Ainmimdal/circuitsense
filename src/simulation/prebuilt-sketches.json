  "code": "// Blink: flash the LED on pin 13\nconst int LED_PIN = 13;\n\nvoid setup() {\n  pinMode(LED_PIN, OUTPUT);   // pin 13 drives the LED\n}\n\nvoid loop() {\n  digitalWrite(LED_PIN, HIGH); // 5 V: LED on\n  delay(1000);                 // wait one second\n  digitalWrite(LED_PIN, LOW);  // 0 V: LED off\n  delay(1000);\n}",
