    {"name": "D4", "capabilities": ["digital", "pwm"]},
    {"name": "D5", "capabilities": ["digital", "pwm"]},
    {"name": "D6", "capabilities": ["digital", "pwm"]},
    {"name": "D7", "capabilities": ["digital", "pwm"]},
    {"name": "D8", "capabilities": ["digital", "pwm"]},
    {"name": "D9", "capabilities": ["digital", "pwm"]},
    {"name": "D10", "capabilities": ["digital", "pwm"]},
    {"name": "D11", "capabilities": ["digital", "pwm"]},
    {"name": "D12", "capabilities": ["digital", "pwm"]},
    {"name": "D13", "capabilities": ["digital"]},
    {"name": "A0", "capabilities": ["analog"]},
    {"name": "A1", "capabilities": ["analog"]},
    {"name": "A2", "capabilities": ["analog"]},
    {"name": "A3", "capabilities": ["analog"]},
    {"name": "A4", "capabilities": ["analog", "i2c_sda"]},
