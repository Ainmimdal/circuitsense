{
  "format": "elera-board-pins-v1",
  "id": "arduino-uno",
  "name": "Arduino Uno",
  "logicVoltage": 5,
  "maxCurrent_mA": 500,
  "pinMaxCurrent_mA": 40,
  "pins": [
    {"name": "0", "capabilities": ["uart_rx"], "constraints": [{"type": "serial_reserved", "severity": "warning"}], "exit": "up"},
    {"name": "1", "capabilities": ["uart_tx"], "constraints": [{"type": "serial_reserved", "severity": "warning"}], "exit": "up"},
    {"name": "2", "capabilities": ["digital"], "exit": "up"},
    {"name": "3", "capabilities": ["digital", "pwm"], "exit": "up"},
    {"name": "4", "capabilities": ["digital"], "exit": "up"},
    {"name": "5", "capabilities": ["digital", "pwm"], "exit": "up"},
    {"name": "6", "capabilities": ["digital", "pwm"], "exit": "up"},
    {"name": "7", "capabilities": ["digital"], "exit": "up"},
    {"name": "8", "capabilities": ["digital"], "exit": "up"},
    {"name": "9", "capabilities": ["digital", "pwm"], "exit": "up"},
    {"name": "10", "capabilities": ["digital", "pwm"], "exit": "up"},
    {"name": "11", "capabilities": ["digital", "pwm"], "exit": "up"},
    {"name": "12", "capabilities": ["digital"], "exit": "up"},
    {"name": "13", "capabilities": ["digital"], "exit": "up"},
    {"name": "A0", "capabilities": ["analog"], "exit": "down"},
    {"name": "A1", "capabilities": ["analog"], "exit": "down"},
    {"name": "A2", "capabilities": ["analog"], "exit": "down"},
    {"name": "A3", "capabilities": ["analog"], "exit": "down"},
    {"name": "A4", "capabilities": ["analog", "i2c_sda"], "exit": "down"},
    {"name": "A5", "capabilities": ["analog", "i2c_scl"], "exit": "down"},
    {"name": "5V", "capabilities": ["power"], "exit": "down"},
    {"name": "3.3V", "capabilities": ["power"], "exit": "down"},
    {"name": "GND.1", "capabilities": ["ground"], "exit": "down"},
    {"name": "GND.2", "capabilities": ["ground"], "exit": "down"},
    {"name": "GND.3", "capabilities": ["ground"], "exit": "up"},
    {"name": "VIN", "capabilities": [], "exit": "down"},
    {"name": "IOREF", "capabilities": [], "exit": "down"},
    {"name": "RESET", "capabilities": [], "exit": "down"},
    {"name": "AREF", "capabilities": [], "exit": "up"}
  ]
}
