        "test": "node --test"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.117.3",
        "@wokwi/elements": "^1.9.2",
        "konva": "^9.3.22",
        "lit": "^3.2.0"
    },
    "devDependencies": {
        "@xmldom/xmldom": "^0.9.12",
        "fake-indexeddb": "^6.2.5",
        "fflate": "^0.8.3",
        "vite": "^6.0.0"
