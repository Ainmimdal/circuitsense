{
    "name": "circuitsense",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "components:generate": "node scripts/generate-wokwi-manifest.mjs",
        "parts:convert-fritzing": "node scripts/convert-fritzing-part.mjs",
        "components:check": "node scripts/generate-wokwi-manifest.mjs --check",
